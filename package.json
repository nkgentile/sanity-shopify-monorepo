{
  "name": "root",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo --ui tui dev",
    "watch:apps": "turbo --ui tui dev --filter=\"./apps/**\"",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --cache --write --ignore-unknown ."
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.3",
    "prettier-plugin-packagejson": "^2.5.20",
    "turbo": "^2.6.1"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "overrides": {
      "styled-components": "npm:@sanity/css-in-js@^6.1.26"
    }
  }
}
